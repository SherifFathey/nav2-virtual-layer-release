<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_virtual_layer</name>
  <version>0.0.1</version>
  <description>Virtual restriction layer for Nav2 costmap</description>

  <maintainer email="sherif.fathey@outlook.com">Sherif Fathey</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/SherifFathey/nav2-virtual-layer</url>
  <url type="bugtracker">https://github.com/SherifFathey/nav2-virtual-layer/issues</url>
  <url type="repository">https://github.com/SherifFathey/nav2-virtual-layer</url>

  <author email="sherif.fathey@outlook.com">Sherif Fathey</author>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pluginlib</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/plugin.xml"/>
  </export>
</package>
